# ==========================================
# SmartDesk AI - Backend Environment Configuration
# ==========================================

# Core Application
PROJECT_NAME="SmartDesk AI - Customer Support & Knowledge Synthesizer"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=False

# AI Provider: "gemini" (Google Cloud API) or "ollama" (Local 100% Free)
AI_PROVIDER="gemini"

# Google Gemini API (Required if AI_PROVIDER="gemini")
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
LLM_MODEL_NAME="gemini-3.5-flash-lite"
LLM_FALLBACK_MODEL=""
LLM_FALLBACK_MODEL_NAME="gemini-2.5-flash-lite"
EMBEDDING_MODEL_NAME="gemini-embedding-001"
LLM_INPUT_COST_PER_MILLION=0.30
LLM_OUTPUT_COST_PER_MILLION=2.50

# Local Ollama Settings (Required if AI_PROVIDER="ollama")
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_LLM_MODEL="qwen2.5:3b"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_TIMEOUT_SECONDS=30.0
OLLAMA_KEEP_ALIVE="30m"

# Circuit Breaker & Latency Constraints (Max 4.0s for Cloud Gemini)
LLM_TIMEOUT_SECONDS=4.0
RATE_LIMIT_COOLDOWN_SECONDS=60
RAG_CONFIDENCE_THRESHOLD=0.65
RAG_MIN_SIMILARITY_SCORE=0.25

# Document Chunking Settings
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Authentication & RBAC (Hybrid Google OAuth2 + Demo Login - REQ-06, REQ-09, REQ-36)
# JWT_SECRET_KEY: leave EMPTY (as below) to get a random per-process secret when DEMO_LOGIN_ENABLED=true;
# tokens then become invalid after every restart. For a stable secret set >= 32 random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# With DEMO_LOGIN_ENABLED=false an empty/known-default secret makes the server refuse to start.
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
GOOGLE_OAUTH_CLIENT_ID=""
ADMIN_EMAILS=""
DEMO_LOGIN_ENABLED=true
DEMO_ADMIN_PASSWORD="Admin@SmartDesk2026"
DEMO_USER_PASSWORD="User@SmartDesk2026"
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_THROTTLE_WINDOW_SECONDS=60

# Database Configuration
# Default to SQLite Async for rapid local development/testing:
DATABASE_URL="sqlite+aiosqlite:///./smartdesk.db"
FALLBACK_SQLITE_URL="sqlite+aiosqlite:///./smartdesk.db"
# Or PostgreSQL 16 with pgvector:
# Or PostgreSQL 16 with pgvector (demo default password for local docker-compose):
# POSTGRES_PASSWORD="postgrespassword"
# DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/smartdesk"

# CORS Origins (JSON array or comma-separated string)
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]'

# Seed Data & Prompt Catalog Paths
SEED_FAQ_PATH="data/seed_faq.json"
PROMPTS_PATH="data/prompts.json"
