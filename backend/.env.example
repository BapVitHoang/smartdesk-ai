# ==========================================
# SmartDesk AI - Backend Environment Configuration
# ==========================================

# Core Application
PROJECT_NAME="SmartDesk AI - Customer Support & Knowledge Synthesizer"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=False

# AI Provider: "gemini" (Google Cloud API) or "ollama" (Local 100% Free)
AI_PROVIDER="gemini"

# Google Gemini API (Required if AI_PROVIDER="gemini")
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
LLM_MODEL_NAME="gemini-3.5-flash-lite"
LLM_FALLBACK_MODEL_NAME="gemini-2.5-flash-lite"
EMBEDDING_MODEL_NAME="gemini-embedding-001"

# Local Ollama Settings (Required if AI_PROVIDER="ollama")
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_LLM_MODEL="qwen2.5:3b"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_TIMEOUT_SECONDS=30.0
OLLAMA_KEEP_ALIVE="30m"

# Circuit Breaker & Latency Constraints (Max 4.0s for Cloud Gemini)
LLM_TIMEOUT_SECONDS=4.0
RAG_CONFIDENCE_THRESHOLD=0.65

# Database Configuration
# Default to SQLite Async for rapid local development/testing:
DATABASE_URL="sqlite+aiosqlite:///./smartdesk.db"
FALLBACK_SQLITE_URL="sqlite+aiosqlite:///./smartdesk.db"
# Or PostgreSQL 16 with pgvector:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/smartdesk"

# CORS Origins (JSON array or comma-separated string)
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]'

# Seed Data & Prompt Catalog Paths
SEED_FAQ_PATH="data/seed_faq.json"
PROMPTS_PATH="data/prompts.json"
